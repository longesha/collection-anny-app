# Serveur
PORT=5000
NODE_ENV=development

# Frontend autorisé à appeler l'API
CLIENT_URL=http://localhost:5173

# MySQL (à adapter à votre installation locale)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=collection_anny

# Sécurité des comptes (à générer et garder secrets, jamais publier)
JWT_SECRET=change_me_to_a_random_secret_at_least_32_characters
ADMIN_INVITE_CODE=change_me_to_a_private_admin_invitation_code
