# Serveur
PORT=5001
NODE_ENV=development

# Frontend autorisé à appeler l'API
CLIENT_URL=http://localhost:5173

# Base de données Neon PostgreSQL
# Ajouter ici la chaîne de connexion récupérée dans Neon (ne jamais publier le vrai .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Sécurité des comptes (à générer et garder secrets, jamais publier)
JWT_SECRET=change_me_to_a_random_secret_at_least_32_characters
ADMIN_INVITE_CODE=change_me_to_a_private_admin_invitation_code